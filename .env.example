# Copy to .env and fill in. docker compose reads it; .env is never committed.

# Your GitLab. For the official one use https://gitlab.com
GITLAB_URL=https://gitlab.com

# From GitLab: User settings (or Admin Area) > Applications. Scope: api.
# Redirect URI there must be: <PUBLIC_URL>/auth/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# The address people use to open gitmap
PUBLIC_URL=http://localhost:8080

# Optional
# ANALYSIS_WORKERS=2
# NODE_EXTRA_CA_CERTS=/certs/company-ca.pem
# GIT_SSL_CAINFO=/certs/company-ca.pem
