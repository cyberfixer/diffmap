# diffmap service settings. Copy to .env and fill in; .env is never committed.
# One diffmap serves one code host. For a second host, copy this to another
# file (e.g. .env.github) and see docker-compose.yml.

# gitlab or github
CODE_HOST=gitlab

# The address people use to open this diffmap
PUBLIC_URL=http://localhost:8080

# ── GitLab (CODE_HOST=gitlab) ──
# Your GitLab. For the official one use https://gitlab.com
GITLAB_URL=https://gitlab.com
# Full mode (sign in with GitLab, comment, approve): a GitLab application.
#   GitLab: Admin Area (or Preferences) > Applications. Scope: api.
#   Redirect URI there must be: <PUBLIC_URL>/auth/callback
# View-only mode: leave BOTH empty; people sign in with their own token.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# ── GitHub (CODE_HOST=github) ──
# github.com by default; set your address for GitHub Enterprise Server.
# GITHUB_URL=https://github.com
# Full mode: a GitHub OAuth App.
#   GitHub: Settings > Developer settings > OAuth Apps > New OAuth App
#   Authorization callback URL there must be: <PUBLIC_URL>/auth/callback
# View-only mode: leave BOTH empty.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Optional ──
# ANALYSIS_WORKERS=2
# CI job (GitLab) or Actions artifact (GitHub) with the exact index, see ci/
# INDEX_JOB=diffmap-index
# INDEX_ARTIFACT=index.scip
# NODE_EXTRA_CA_CERTS=/certs/company-ca.pem
# GIT_SSL_CAINFO=/certs/company-ca.pem
