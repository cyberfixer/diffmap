{
  "name": "diffmap",
  "version": "0.1.0",
  "description": "See which functions a code change touches and where they are used, as a map. CLI and GitLab merge request service.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "code-review",
    "git",
    "gitlab",
    "merge-request",
    "diff",
    "call-graph",
    "tree-sitter"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "diffmap": "bin/diffmap.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "parse-diff": "^0.11.1",
    "tree-sitter-wasms": "^0.1.13",
    "ts-morph": "^24.0.0",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
