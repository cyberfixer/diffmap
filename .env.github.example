# Settings for the diffmap-github container. Copy to .env.github and fill in.
# docker compose reads it; .env.github is never committed.

# github.com by default; set your address for GitHub Enterprise Server.
# GITHUB_URL=https://github.com

# Full mode (sign in with GitHub, comment, approve): a GitHub OAuth App.
#   GitHub: Settings > Developer settings > OAuth Apps > New OAuth App
#   (or the same under your organization's settings).
#   Authorization callback URL there must be: <PUBLIC_URL>/auth/callback
# View-only mode: leave BOTH empty; people sign in with their own token.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The address people use to open this diffmap
PUBLIC_URL=http://localhost:8081

# Optional
# ANALYSIS_WORKERS=2
# Actions artifact with the exact index (see ci/diffmap-index.github-workflow.yml)
# INDEX_JOB=diffmap-index
# INDEX_ARTIFACT=index.scip
