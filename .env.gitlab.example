# Settings for the diffmap-gitlab container. Copy to .env.gitlab and fill in.
# docker compose reads it; .env.gitlab is never committed.

# Your GitLab. For the official one use https://gitlab.com
GITLAB_URL=https://gitlab.com

# Full mode (sign in with GitLab, comment, approve): a GitLab application.
#   GitLab: Admin Area (or Preferences) > Applications. Scope: api.
#   Redirect URI there must be: <PUBLIC_URL>/auth/callback
# View-only mode: leave BOTH empty; people sign in with their own token.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# The address people use to open this diffmap
PUBLIC_URL=http://localhost:8080

# Optional
# ANALYSIS_WORKERS=2
# CI job and artifact with the exact index (see ci/diffmap-index.gitlab-ci.yml)
# INDEX_JOB=diffmap-index
# INDEX_ARTIFACT=index.scip
# NODE_EXTRA_CA_CERTS=/certs/company-ca.pem
# GIT_SSL_CAINFO=/certs/company-ca.pem
